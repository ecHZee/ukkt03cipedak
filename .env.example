# Salin file ini menjadi `.env.local`, lalu isi nilainya.
# `.env.local` TIDAK ikut ke git. Jangan kirim isinya lewat chat.

# Supabase → tombol "Connect" di dashboard proyek
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sama dengan dua nilai di atas, dipakai saat render di server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# RAHASIA — hanya untuk server, jangan pernah diawali VITE_
# Supabase → Project Settings → API Keys → secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# RAHASIA — token akun Supabase Katar untuk CLI (`npm run db -- ...`), diawali sbp_
# Supabase → avatar → Account Preferences → Access Tokens
SUPABASE_ACCESS_TOKEN=

# Alamat publik web (tanpa garis miring di akhir)
VITE_SITE_URL=http://localhost:5173
